{
  "manifest_version": 3,
  "name": "WAUX",
  "short_name": "WAUX",
  "version": "1.0.0",
  "description": "WhatsApp Web, redesigned. Premium theme engine, privacy blur, quick messages. Everything stays on your device.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_title": "WAUX",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_page": "studio.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["skin.css", "avatars.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2", "fonts/*.ttf"], "matches": ["https://web.whatsapp.com/*"] }
  ],
  "commands": {
    "toggle-shield": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle Privacy Shield"
    },
    "toggle-focus": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle Focus Mode"
    }
  }
}
